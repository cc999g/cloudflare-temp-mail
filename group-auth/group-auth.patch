+// ---------- TG 群聊鉴权（可选，默认优先于 admin 密码） ----------
+// 请求头 x-tg-auth 携带 Telegram Login Widget 认证数据 JSON：
+//   {"id":123,"first_name":"..","auth_date":1700000000,"hash":".."}
+// 校验：HMAC-SHA256(data_check_string, sha256(TELEGRAM_BOT_TOKEN)) == hash
+//      且该 user 是 AUTH_GROUP_ID 授权群成员（creator/administrator/member/restricted）
+export const verifyTgGroupMember = async (c: Context<HonoCustomType>, tgAuthRaw: string | null): Promise<boolean> => {
+    if (!tgAuthRaw) return false;
+    if (!c.env.AUTH_GROUP_ID || !c.env.TELEGRAM_BOT_TOKEN) return false;
+    try {
+        let data: Record<string, string> = {};
+        if (typeof tgAuthRaw === "string") {
+            const parsed = JSON.parse(tgAuthRaw);
+            data = parsed && typeof parsed === "object" ? parsed : {};
+        }
+        const id = String(data.id || "");
+        const authDate = String(data.auth_date || "");
+        const hash = String(data.hash || "");
+        if (!id || !authDate || !hash) return false;
+        const fields: string[] = [];
+        for (const key of Object.keys(data).sort()) {
+            if (key === "hash") continue;
+            fields.push(`${key}=${String(data[key])}`);
+        }
+        const dataCheckString = fields.join("\n");
+        const secretKey = await crypto.subtle.digest("SHA-256", new TextEncoder().encode(c.env.TELEGRAM_BOT_TOKEN));
+        const key = await crypto.subtle.importKey("raw", secretKey, { name: "HMAC" }, false, ["sign"]);
+        const sig = await crypto.subtle.sign("HMAC", key, new TextEncoder().encode(dataCheckString));
+        const sigHex = [...new Uint8Array(sig)].map(b => b.toString(16).padStart(2, "0")).join("");
+        if (sigHex !== hash) return false;
+        // auth_date 超过 1 天视为过期
+        if (Math.floor(Date.now() / 1000) - Number(authDate) > 86400) return false;
+        const res = await fetch(`https://api.telegram.org/bot${c.env.TELEGRAM_BOT_TOKEN}/getChatMember`, {
+            method: "POST",
+            headers: { "content-type": "application/json" },
+            body: JSON.stringify({ chat_id: Number(c.env.AUTH_GROUP_ID), user_id: Number(id) }),
+        }).then(r => r.json()) as { ok?: boolean; result?: { status?: string } };
+        if (!res.ok || !res.result) return false;
+        const st = res.result.status;
+        return st === "creator" || st === "administrator" || st === "member" || st === "restricted";
+    } catch (e) {
+        console.error("Failed to verify TG group auth", e);
+        return false;
+    }
+}
